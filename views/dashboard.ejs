<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Keg Tracking System</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      padding: 20px;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      background: white;
      border-radius: 10px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.2);
      padding: 30px;
    }

    header {
      text-align: center;
      margin-bottom: 30px;
      border-bottom: 3px solid #667eea;
      padding-bottom: 20px;
    }

    h1 { color: #333; font-size: 2.5em; }
    .subtitle { color: #666; margin-top: 5px; }

    .controls {
      display: flex;
      gap: 10px;
      margin-bottom: 30px;
      flex-wrap: wrap;
    }

    button {
      padding: 12px 24px;
      font-size: 16px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      background: #667eea;
      color: white;
      transition: background 0.3s;
    }

    button:hover { background: #764ba2; }
    button.secondary { background: #6c757d; }
    button.secondary:hover { background: #5a6268; }

    input[type="text"], input[type="number"], select {
      padding: 12px;
      font-size: 16px;
      border: 1px solid #ddd;
      border-radius: 5px;
      flex: 1;
      min-width: 200px;
    }

    .table-container {
      overflow-x: auto;
      margin-top: 30px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }

    thead {
      background: #f8f9fa;
      border-bottom: 2px solid #667eea;
    }

    th {
      padding: 15px;
      text-align: left;
      font-weight: 600;
      color: #333;
    }

    td {
      padding: 12px 15px;
      border-bottom: 1px solid #eee;
    }

    tr:hover { background: #f9f9f9; }

    .status {
      padding: 5px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      text-align: center;
    }

    .status.available { background: #d4edda; color: #155724; }
    .status.in-use { background: #fff3cd; color: #856404; }
    .status.maintenance { background: #f8d7da; color: #721c24; }

    .action-buttons {
      display: flex;
      gap: 5px;
    }

    .action-buttons button {
      padding: 6px 12px;
      font-size: 12px;
      flex: 1;
    }

    .modal {
      display: none;
      position: fixed;
      z-index: 1000;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.5);
      animation: fadeIn 0.3s;
    }

    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    .modal-content {
      background: white;
      margin: 5% auto;
      padding: 30px;
      border: 1px solid #888;
      border-radius: 10px;
      width: 90%;
      max-width: 500px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.3);
      animation: slideIn 0.3s;
    }

    @keyframes slideIn { from { transform: translateY(-50px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

    .modal-header {
      font-size: 24px;
      font-weight: 600;
      margin-bottom: 20px;
      color: #333;
    }

    .form-group {
      margin-bottom: 15px;
    }

    label {
      display: block;
      margin-bottom: 5px;
      font-weight: 600;
      color: #333;
    }

    input, select, textarea {
      width: 100%;
      padding: 10px;
      border: 1px solid #ddd;
      border-radius: 5px;
      font-size: 14px;
    }

    textarea { resize: vertical; min-height: 80px; }

    .modal-footer {
      display: flex;
      gap: 10px;
      margin-top: 30px;
      justify-content: flex-end;
    }

    .close {
      color: #aaa;
      float: right;
      font-size: 28px;
      font-weight: bold;
      cursor: pointer;
    }

    .close:hover { color: #000; }

    .alert { padding: 15px; margin-bottom: 20px; border-radius: 5px; }
    .alert.success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
    .alert.error { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }

    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }

    .stat-card {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 20px;
      border-radius: 10px;
      text-align: center;
    }

    .stat-number { font-size: 32px; font-weight: bold; }
    .stat-label { font-size: 14px; margin-top: 5px; opacity: 0.9; }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>🍺 Keg Tracking System</h1>
      <p class="subtitle">Manage and track your kegs efficiently</p>
    </header>

    <div id="alert"></div>

    <div class="stats">
      <div class="stat-card">
        <div class="stat-number" id="totalKegs">0</div>
        <div class="stat-label">Total Kegs</div>
      </div>
      <div class="stat-card">
        <div class="stat-number" id="availableKegs">0</div>
        <div class="stat-label">Available</div>
      </div>
      <div class="stat-card">
        <div class="stat-number" id="inUseKegs">0</div>
        <div class="stat-label">In Use</div>
      </div>
    </div>

    <div class="controls">
      <button onclick="openAddModal()">+ Add New Keg</button>
      <input type="text" id="searchInput" placeholder="Search kegs..." onkeyup="filterKegs()">
    </div>

    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Location</th>
            <th>Quantity</th>
            <th>Status</th>
            <th>Last Updated</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="kegsTable"></tbody>
      </table>
    </div>
  </div>

  <!-- Add/Edit Modal -->
  <div id="kegModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="closeModal()">&times;</span>
      <div class="modal-header" id="modalTitle">Add New Keg</div>
      <form id="kegForm">
        <div class="form-group">
          <label>Keg Name</label>
          <input type="text" id="kegName" required>
        </div>
        <div class="form-group">
          <label>Type</label>
          <input type="text" id="kegType" placeholder="e.g., IPA, Lager, Stout" required>
        </div>
        <div class="form-group">
          <label>Location</label>
          <input type="text" id="kegLocation" placeholder="e.g., Warehouse A, Bar 1" required>
        </div>
        <div class="form-group">
          <label>Quantity</label>
          <input type="number" id="kegQuantity" value="1" min="1">
        </div>
        <div class="form-group">
          <label>Status</label>
          <select id="kegStatus">
            <option value="available">Available</option>
            <option value="in-use">In Use</option>
            <option value="maintenance">Maintenance</option>
          </select>
        </div>
        <div class="form-group">
          <label>Notes</label>
          <textarea id="kegNotes"></textarea>
        </div>
        <div class="modal-footer">
          <button type="button" class="secondary" onclick="closeModal()">Cancel</button>
          <button type="submit">Save Keg</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Transfer Modal -->
  <div id="transferModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="closeTransferModal()">&times;</span>
      <div class="modal-header">Transfer Keg</div>
      <form id="transferForm">
        <div class="form-group">
          <label>New Location</label>
          <input type="text" id="newLocation" placeholder="e.g., Warehouse B, Bar 2" required>
        </div>
        <div class="form-group">
          <label>Operator Name</label>
          <input type="text" id="operatorName" required>
        </div>
        <div class="form-group">
          <label>Notes</label>
          <textarea id="transferNotes"></textarea>
        </div>
        <div class="modal-footer">
          <button type="button" class="secondary" onclick="closeTransferModal()">Cancel</button>
          <button type="submit">Complete Transfer</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Adjust Quantity Modal -->
  <div id="adjustModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="closeAdjustModal()">&times;</span>
      <div class="modal-header">Adjust Quantity</div>
      <form id="adjustForm">
        <div class="form-group">
          <label>Quantity Change (positive to add, negative to remove)</label>
          <input type="number" id="quantityChange" required>
        </div>
        <div class="form-group">
          <label>Operator Name</label>
          <input type="text" id="operatorName2" required>
        </div>
        <div class="form-group">
          <label>Reason</label>
          <textarea id="adjustNotes"></textarea>
        </div>
        <div class="modal-footer">
          <button type="button" class="secondary" onclick="closeAdjustModal()">Cancel</button>
          <button type="submit">Adjust Quantity</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    let currentKegId = null;
    let kegs = [];

    // Load kegs on page load
    document.addEventListener('DOMContentLoaded', loadKegs);

    // Form submissions
    document.getElementById('kegForm').addEventListener('submit', handleSaveKeg);
    document.getElementById('transferForm').addEventListener('submit', handleTransfer);
    document.getElementById('adjustForm').addEventListener('submit', handleAdjust);

    async function loadKegs() {
      try {
        const response = await fetch('/api/kegs');
        kegs = await response.json();
        renderKegs();
        updateStats();
      } catch (error) {
        showAlert('Error loading kegs: ' + error.message, 'error');
      }
    }

    function renderKegs() {
      const tbody = document.getElementById('kegsTable');
      tbody.innerHTML = '';

      kegs.forEach(keg => {
        const row = document.createElement('tr');
        const lastUpdated = new Date(keg.last_updated).toLocaleString();
        
        row.innerHTML = `
          <td>${keg.name}</td>
          <td>${keg.type}</td>
          <td>${keg.location}</td>
          <td>${keg.quantity}</td>
          <td><span class="status ${keg.status.replace(' ', '-')}">${keg.status}</span></td>
          <td>${lastUpdated}</td>
          <td>
            <div class="action-buttons">
              <button onclick="openEditModal(${keg.id})">Edit</button>
              <button class="secondary" onclick="openTransfer(${keg.id})">Move</button>
              <button class="secondary" onclick="openAdjust(${keg.id})">Qty</button>
              <button class="secondary" onclick="viewHistory(${keg.id})">History</button>
              <button class="secondary" onclick="deleteKeg(${keg.id})">Delete</button>
            </div>
          </td>
        `;
        tbody.appendChild(row);
      });
    }

    function updateStats() {
      document.getElementById('totalKegs').textContent = kegs.length;
      document.getElementById('availableKegs').textContent = kegs.filter(k => k.status === 'available').length;
      document.getElementById('inUseKegs').textContent = kegs.filter(k => k.status === 'in-use').length;
    }

    function filterKegs() {
      const query = document.getElementById('searchInput').value.toLowerCase();
      const filtered = kegs.filter(k => 
        k.name.toLowerCase().includes(query) ||
        k.type.toLowerCase().includes(query) ||
        k.location.toLowerCase().includes(query)
      );
      
      const tbody = document.getElementById('kegsTable');
      tbody.innerHTML = '';
      filtered.forEach(keg => {
        const row = document.createElement('tr');
        const lastUpdated = new Date(keg.last_updated).toLocaleString();
        row.innerHTML = `
          <td>${keg.name}</td>
          <td>${keg.type}</td>
          <td>${keg.location}</td>
          <td>${keg.quantity}</td>
          <td><span class="status ${keg.status.replace(' ', '-')}">${keg.status}</span></td>
          <td>${lastUpdated}</td>
          <td>
            <div class="action-buttons">
              <button onclick="openEditModal(${keg.id})">Edit</button>
              <button class="secondary" onclick="openTransfer(${keg.id})">Move</button>
              <button class="secondary" onclick="openAdjust(${keg.id})">Qty</button>
              <button class="secondary" onclick="viewHistory(${keg.id})">History</button>
              <button class="secondary" onclick="deleteKeg(${keg.id})">Delete</button>
            </div>
          </td>
        `;
        tbody.appendChild(row);
      });
    }

    function openAddModal() {
      currentKegId = null;
      document.getElementById('modalTitle').textContent = 'Add New Keg';
      document.getElementById('kegForm').reset();
      document.getElementById('kegModal').style.display = 'block';
    }

    function openEditModal(id) {
      const keg = kegs.find(k => k.id === id);
      if (!keg) return;

      currentKegId = id;
      document.getElementById('modalTitle').textContent = 'Edit Keg';
      document.getElementById('kegName').value = keg.name;
      document.getElementById('kegType').value = keg.type;
      document.getElementById('kegLocation').value = keg.location;
      document.getElementById('kegQuantity').value = keg.quantity;
      document.getElementById('kegStatus').value = keg.status;
      document.getElementById('kegNotes').value = keg.notes || '';
      document.getElementById('kegModal').style.display = 'block';
    }

    function closeModal() {
      document.getElementById('kegModal').style.display = 'none';
    }

    async function handleSaveKeg(e) {
      e.preventDefault();
      
      const data = {
        name: document.getElementById('kegName').value,
        type: document.getElementById('kegType').value,
        location: document.getElementById('kegLocation').value,
        quantity: parseInt(document.getElementById('kegQuantity').value),
        status: document.getElementById('kegStatus').value,
        notes: document.getElementById('kegNotes').value
      };

      try {
        const url = currentKegId ? `/api/kegs/${currentKegId}` : '/api/kegs';
        const method = currentKegId ? 'PUT' : 'POST';

        const response = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (response.ok) {
          showAlert('Keg saved successfully!', 'success');
          closeModal();
          loadKegs();
        } else {
          showAlert('Error saving keg', 'error');
        }
      } catch (error) {
        showAlert('Error: ' + error.message, 'error');
      }
    }

    function openTransfer(id) {
      currentKegId = id;
      document.getElementById('transferModal').style.display = 'block';
    }

    function closeTransferModal() {
      document.getElementById('transferModal').style.display = 'none';
    }

    async function handleTransfer(e) {
      e.preventDefault();

      const data = {
        to_location: document.getElementById('newLocation').value,
        user: document.getElementById('operatorName').value,
        notes: document.getElementById('transferNotes').value
      };

      try {
        const response = await fetch(`/api/kegs/${currentKegId}/transfer`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (response.ok) {
          showAlert('Keg transferred successfully!', 'success');
          closeTransferModal();
          loadKegs();
        } else {
          showAlert('Error transferring keg', 'error');
        }
      } catch (error) {
        showAlert('Error: ' + error.message, 'error');
      }
    }

    function openAdjust(id) {
      currentKegId = id;
      document.getElementById('adjustModal').style.display = 'block';
    }

    function closeAdjustModal() {
      document.getElementById('adjustModal').style.display = 'none';
    }

    async function handleAdjust(e) {
      e.preventDefault();

      const data = {
        quantity_changed: parseInt(document.getElementById('quantityChange').value),
        user: document.getElementById('operatorName2').value,
        notes: document.getElementById('adjustNotes').value
      };

      try {
        const response = await fetch(`/api/kegs/${currentKegId}/adjust`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (response.ok) {
          showAlert('Quantity adjusted successfully!', 'success');
          closeAdjustModal();
          loadKegs();
        } else {
          showAlert('Error adjusting quantity', 'error');
        }
      } catch (error) {
        showAlert('Error: ' + error.message, 'error');
      }
    }

    async function viewHistory(id) {
      try {
        const response = await fetch(`/api/kegs/${id}/history`);
        const history = await response.json();

        let historyHTML = '<h3>Transaction History</h3><table style="width:100%"><thead><tr><th>Action</th><th>Details</th><th>User</th><th>Date</th></tr></thead><tbody>';
        
        history.forEach(t => {
          const date = new Date(t.timestamp).toLocaleString();
          let details = '';
          
          if (t.action === 'TRANSFER') {
            details = `${t.from_location} → ${t.to_location}`;
          } else {
            details = `${t.action} ${t.quantity_changed} units`;
          }
          
          historyHTML += `<tr><td>${t.action}</td><td>${details}</td><td>${t.user || '-'}</td><td>${date}</td></tr>`;
        });
        
        historyHTML += '</tbody></table>';
        alert(historyHTML);
      } catch (error) {
        showAlert('Error loading history: ' + error.message, 'error');
      }
    }

    async function deleteKeg(id) {
      if (!confirm('Are you sure you want to delete this keg?')) return;

      try {
        const response = await fetch(`/api/kegs/${id}`, { method: 'DELETE' });
        
        if (response.ok) {
          showAlert('Keg deleted successfully!', 'success');
          loadKegs();
        } else {
          showAlert('Error deleting keg', 'error');
        }
      } catch (error) {
        showAlert('Error: ' + error.message, 'error');
      }
    }

    function showAlert(message, type) {
      const alertDiv = document.getElementById('alert');
      alertDiv.innerHTML = `<div class="alert ${type}">${message}</div>`;
      setTimeout(() => alertDiv.innerHTML = '', 4000);
    }

    // Close modal on outside click
    window.onclick = function(event) {
      let modal = document.getElementById('kegModal');
      if (event.target === modal) modal.style.display = 'none';
      
      modal = document.getElementById('transferModal');
      if (event.target === modal) modal.style.display = 'none';
      
      modal = document.getElementById('adjustModal');
      if (event.target === modal) modal.style.display = 'none';
    }
  </script>
</body>
</html>
